# Environment Configuration for Target Sheet App
# Copy this to .env and modify for your deployment

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://yhrtctmhbrfwjiqcqzle.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Authentication Configuration
# For development (localhost)
EXPO_PUBLIC_AUTH_CALLBACK_URL=http://localhost:8081/auth/callback

# For production deployment, update the callback URL to match your domain:
# EXPO_PUBLIC_AUTH_CALLBACK_URL=https://yourdomain.com/auth/callback

# Docker Configuration
# If running in Docker, ensure the callback URL matches your exposed port
# EXPO_PUBLIC_AUTH_CALLBACK_URL=http://localhost:8081/auth/callback

# Development Settings
NODE_ENV=development

# Database Settings (for reference - handled by Supabase)
# - RLS is enabled on all tables
# - Users can only access their own data
# - Comprehensive error logging is enabled